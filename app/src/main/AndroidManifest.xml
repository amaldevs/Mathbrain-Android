<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".MathbrainApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <!-- TODO: replace with the production AdMob App ID (ca-app-pub-…~…) from the
             AdMob console before release. This is Google's public test App ID. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Mathbrain.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation"
            android:exported="false" />
        <activity
            android:name=".GameActivity"
            android:label="@string/title_activity_game"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation"
            android:parentActivityName=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".HighscoresActivity"
            android:label="@string/title_activity_highscores"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation"
            android:parentActivityName=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".HelpActivity"
            android:label="@string/title_activity_help"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation"
            android:parentActivityName=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".CreditsActivity"
            android:label="@string/title_activity_credits"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation"
            android:parentActivityName=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".ScoresActivity"
            android:label="@string/title_activity_scores"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation"
            android:parentActivityName=".GameActivity"
            android:exported="false" />
    </application>

</manifest>
